{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SOMA progress settings v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {"type": "boolean", "default": false},
    "interval_seconds": {"type": "integer", "minimum": 15, "maximum": 3600, "default": 60},
    "message": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\u0000-\\u001f\\u007f]+$", "default": "Still working on your request."}
  }
}
