# Copy to /home/ACCOUNT/soma/config/gateway.env, replace every placeholder,
# then restrict the copied file to mode 0600. All paths must be absolute.
SOMA_RUNTIME=hermes
SOMA_RUNTIME_HOME=/home/ACCOUNT/soma/runtime
HEALTH_OS_REPO=/home/ACCOUNT/soma/source/health-os
HEALTH_OS_WORKSPACE=/home/ACCOUNT/soma/workspace

# Create a separate SOMA bot and use only positive numeric Telegram user IDs.
TELEGRAM_BOT_TOKEN=replace_with_private_soma_bot_token
TELEGRAM_ALLOWED_USERS=replace_with_private_numeric_user_ids

# OpenAI API example: keep the real key only in this private file.
OPENAI_API_KEY=replace_with_private_openai_api_key
