# Copy to a local .env, adjust the values, and source it explicitly.
# See docs/getting-started.md; SOMA does not load .env automatically.

# Absolute path to the pinned Health OS checkout.
HEALTH_OS_REPO="${HOME}/src/health-os-soma"

# Keep the private workspace outside both the SOMA and Health OS repositories.
HEALTH_OS_WORKSPACE="${HOME}/.local/share/soma/workspace"

# Writes stay disabled until the operator transfers workspace ownership.
SOMA_HEALTH_ACTION_MODE=read-only

# SOMA uses the pinned Hermes runtime module by default. Keep its isolated
# installation and Hermes home outside both repositories and any existing
# Hermes profile directory.
SOMA_REPO="${HOME}/src/soma-ai"
SOMA_RUNTIME=hermes
SOMA_RUNTIME_HOME="${HOME}/.local/share/soma/hermes-runtime"

# Optional SSH target for npm run vps:ssh. Uncomment and replace the alias
# with one configured in your local SSH client; see docs/vps.md.
# SOMA_VPS_SSH_HOST=YOUR_SSH_ALIAS
